[Unit]
Description=Disabled candidate: Monday cutoff/preparation/duties and published-summary delivery

[Timer]
OnCalendar=Mon *-*-* 12:00:00 Asia/Shanghai
OnCalendar=Mon *-*-* 13:00:00 Asia/Shanghai
OnCalendar=Mon *-*-* 14:00:00 Asia/Shanghai
OnCalendar=Mon *-*-* 15:00:00 Asia/Shanghai
OnCalendar=Mon *-*-* 16:00:00 Asia/Shanghai
OnCalendar=*-*-* *:00/5:00 Asia/Shanghai
Persistent=false
AccuracySec=1s
Unit=aiwei-weekly-management.service

[Install]
WantedBy=timers.target
